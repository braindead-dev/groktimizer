+fn parse_dotenv_value(contents: &str, name: &str) -> Option<String> {
+    contents.lines().find_map(|line| {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            return None;
+        }
+        let line = line.strip_prefix("export ").unwrap_or(line);
+        let (key, raw_value) = line.split_once('=')?;
+        if key.trim() != name {
+            return None;
+        }
+
+        let raw_value = raw_value.trim();
+        let value = if raw_value.len() >= 2
+            && ((raw_value.starts_with('\'') && raw_value.ends_with('\''))
+                || (raw_value.starts_with('"') && raw_value.ends_with('"')))
+        {
+            &raw_value[1..raw_value.len() - 1]
+        } else {
+            raw_value
+        };
+        (!value.is_empty()).then(|| value.to_owned())
+    })
+}
+
+fn tool_planner_key(name: &str) -> Option<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|value| !value.trim().is_empty())
+        .or_else(|| {
+            // Grok Build is commonly launched from a project terminal. Honor
+            // that project's conventional `.env` without exporting, logging,
+            // or persisting any of its contents.
+            let contents =
+                std::fs::read_to_string(std::env::current_dir().ok()?.join(".env")).ok()?;
+            parse_dotenv_value(&contents, name)
+        })
+}
