+const GROK2_TOOL_CALL_OPEN: &str = "<tool_call>";
+const GROK2_TOOL_CALL_CLOSE: &str = "</tool_call>";
+
+/// Grok-2's published llama.cpp chat template is text-only: it ignores native
+/// `tools`, assistant `tool_calls`, and `tool` result messages. Keep the
+/// compatibility path narrowly scoped to the two upstream model IDs used by
+/// the Groktimizer endpoints.
+pub fn is_grok2_tool_compat_model(model: &str) -> bool {
+    matches!(
+        model.trim().to_ascii_lowercase().as_str(),
+        "grok-2" | "grok-2-fast"
+    )
+}
+
+fn grok2_tool_protocol(tools: &[ToolSpec], tool_choice: Option<&ConversationToolChoice>) -> String {
+    fn compact_schema(schema: &serde_json::Value) -> serde_json::Value {
+        let Some(object) = schema.as_object() else {
+            return schema.clone();
+        };
+        let mut compact = serde_json::Map::new();
+        for key in [
+            "type",
+            "required",
+            "enum",
+            "default",
+            "additionalProperties",
+        ] {
+            if let Some(value) = object.get(key) {
+                compact.insert(key.to_string(), value.clone());
+            }
+        }
+        if let Some(items) = object.get("items") {
+            compact.insert("items".to_string(), compact_schema(items));
+        }
+        if let Some(properties) = object
+            .get("properties")
+            .and_then(serde_json::Value::as_object)
+        {
+            compact.insert(
+                "properties".to_string(),
+                serde_json::Value::Object(
+                    properties
+                        .iter()
+                        .map(|(name, value)| (name.clone(), compact_schema(value)))
+                        .collect(),
+                ),
+            );
+        }
+        serde_json::Value::Object(compact)
+    }
+
+    let compact_tools = tools
+        .iter()
+        .map(|tool| {
+            let description = tool
+                .description
+                .as_deref()
+                .unwrap_or_default()
+                .lines()
+                .next()
+                .unwrap_or_default()
+                .chars()
+                .take(160)
+                .collect::<String>();
+            serde_json::json!({
+                "name": tool.name,
+                "description": description,
+                "parameters": compact_schema(&tool.parameters),
+            })
+        })
+        .collect::<Vec<_>>();
+    let tools_json = serde_json::to_string(&compact_tools).unwrap_or_else(|_| "[]".to_string());
+    let choice = match tool_choice {
+        Some(ConversationToolChoice::Required) => "You MUST call a tool on this turn.",
+        Some(ConversationToolChoice::Function(name)) => {
+            return format!(
+                r#"<grok_build_tool_protocol>
+You are an autonomous coding agent inside Grok Build. The user expects you to perform work, not merely explain it. You MUST call the tool named {name:?} on this turn.
+
+To call a tool, output exactly one envelope with valid compact JSON and no Markdown or prose:
+{GROK2_TOOL_CALL_OPEN}{{"name":{name:?},"arguments":{{...}}}}{GROK2_TOOL_CALL_CLOSE}
+
+Use the exact argument names and types from AVAILABLE_TOOLS_JSON. Tool results arrive in <tool_result> envelopes. After each result, call another tool if work remains; only give a normal final answer after tool output proves the task is complete.
+AVAILABLE_TOOLS_JSON={tools_json}
+</grok_build_tool_protocol>"#
+            );
+        }
+        Some(ConversationToolChoice::None) => "Do not call a tool on this turn.",
+        _ => {
+            "Call a tool whenever the request requires inspecting, creating, editing, or executing anything."
+        }
+    };
+    format!(
+        r#"<grok_build_tool_protocol>
+You are an autonomous coding agent inside Grok Build. The user expects you to perform work, not merely explain how they could do it. {choice}
+
+To call a tool, output exactly one envelope with valid compact JSON and no Markdown or prose:
+{GROK2_TOOL_CALL_OPEN}{{"name":"TOOL_NAME","arguments":{{...}}}}{GROK2_TOOL_CALL_CLOSE}
+
+Your response is machine-parsed. For every request that requires an action, your very first output must be `<tool_call>`; an explanation instead of a tool call fails the task. Use only a tool name from AVAILABLE_TOOLS_JSON and use its exact argument names and types. Make one tool call at a time.
+
+Example for a request that needs a shell command:
+{GROK2_TOOL_CALL_OPEN}{{"name":"run_terminal_command","arguments":{{"command":"pwd","description":"Inspect the current working directory"}}}}{GROK2_TOOL_CALL_CLOSE}
+
+Tool results arrive in <tool_result> envelopes. After each result, call another tool if work remains; only give a normal final answer after tool output proves the task is complete. Never print code that the user asked you to save to disk: use a file or terminal tool to save it.
+AVAILABLE_TOOLS_JSON={tools_json}
+</grok_build_tool_protocol>"#
+    )
+}
+
+fn apply_grok2_tool_compat(
+    messages: &mut Vec<ChatRequestMessage>,
+    tools: &[ToolSpec],
+    tool_choice: Option<&ConversationToolChoice>,
+) {
+    if tools.is_empty() {
+        return;
+    }
+
+    let protocol = grok2_tool_protocol(tools, tool_choice);
+    if let Some(system) = messages
+        .iter_mut()
+        .find(|message| message.role == Role::System)
+    {
+        // Grok-2 has a much smaller effective instruction budget than the
+        // native Grok Build models. Its stock agent prompt is both too large
+        // and assumes native tool calls, so use the concise compatibility
+        // protocol as the complete system message for this narrow path.
+        system.set_text_content(protocol);
