+/// Pick an xAI key without ever persisting it in Grok Build's model config.
+///
+/// The two names deliberately match Groktimizer's documented environment
+/// contract. Rotating at request boundaries spreads both initial prompts and
+/// follow-up tool-result turns across the available quota pools.
+fn next_tool_planner_api_key() -> Option<String> {
+    let mut keys = ["XAI_API_KEY", "XAI_API_KEY_2"]
+        .into_iter()
+        .filter_map(tool_planner_key)
+        .map(|key| key.trim().to_owned())
+        .filter(|key| !key.is_empty())
+        .collect::<Vec<_>>();
+    keys.dedup();
+
+    if keys.is_empty() {
+        return None;
+    }
+
+    let index = NEXT_TOOL_PLANNER_KEY.fetch_add(1, Ordering::Relaxed) % keys.len();
+    Some(keys.swap_remove(index))
+}
