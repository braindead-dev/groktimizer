+fn tool_call_from_value(value: &serde_json::Value) -> Option<(String, String)> {
+    let value = value.get("function").unwrap_or(value);
+    let name = value.get("name")?.as_str()?.trim();
+    if name.is_empty() {
+        return None;
+    }
+    let arguments = match value.get("arguments") {
+        Some(serde_json::Value::String(encoded)) => {
+            if serde_json::from_str::<serde_json::Value>(encoded).is_ok() {
+                encoded.clone()
+            } else {
+                serde_json::Value::String(encoded.clone()).to_string()
+            }
+        }
+        Some(arguments) => arguments.to_string(),
+        None => "{}".to_string(),
+    };
+    Some((name.to_string(), arguments))
+}
+
+fn tool_calls_from_value(value: &serde_json::Value) -> Vec<(String, String)> {
