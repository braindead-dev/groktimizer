+/// Parse the text envelope taught to Grok-2 into native tool calls. Accept a
+/// whole-response JSON object too: older checkpoints occasionally omit the
+/// XML-like wrapper even when they preserve the exact JSON shape.
+fn parse_grok2_tool_calls(
+    content: &str,
+    request_id: &RequestId,
+) -> Option<(String, Vec<ToolCall>)> {
+    let mut outside = String::new();
+    let mut parsed = Vec::<(String, String)>::new();
+    let mut cursor = 0usize;
+    let mut found_envelope = false;
+
+    while let Some(relative_start) = content[cursor..].find(GROK2_TOOL_CALL_OPEN) {
+        found_envelope = true;
+        let start = cursor + relative_start;
+        outside.push_str(&content[cursor..start]);
+        let payload_start = start + GROK2_TOOL_CALL_OPEN.len();
+        let Some(relative_end) = content[payload_start..].find(GROK2_TOOL_CALL_CLOSE) else {
+            return None;
+        };
+        let end = payload_start + relative_end;
+        let payload = content[payload_start..end]
+            .trim()
+            .trim_start_matches("```json")
+            .trim_start_matches("```")
+            .trim_end_matches("```")
+            .trim();
+        let value = serde_json::from_str::<serde_json::Value>(payload).ok()?;
+        let calls = tool_calls_from_value(&value);
+        if calls.is_empty() {
+            return None;
+        }
+        parsed.extend(calls);
+        cursor = end + GROK2_TOOL_CALL_CLOSE.len();
+    }
+
+    if found_envelope {
+        outside.push_str(&content[cursor..]);
+    } else {
+        let payload = content
+            .trim()
+            .trim_start_matches("```json")
+            .trim_start_matches("```")
+            .trim_end_matches("```")
+            .trim();
+        let value = serde_json::from_str::<serde_json::Value>(payload).ok()?;
+        parsed = tool_calls_from_value(&value);
+        if parsed.is_empty() {
+            return None;
+        }
+    }
+
+    let calls = parsed
+        .into_iter()
+        .enumerate()
+        .map(|(index, (name, arguments))| ToolCall {
+            id: std::sync::Arc::<str>::from(format!(
+                "call_grok2_{}_{}",
+                request_id.as_str(),
+                index
+            )),
+            name,
+            arguments: std::sync::Arc::<str>::from(arguments),
+        })
+        .collect();
+    Some((outside.trim().to_string(), calls))
+}
