diff --git a/crates/codegen/xai-grok-pager/src/branding.rs b/crates/codegen/xai-grok-pager/src/branding.rs
new file mode 100644
index 0000000..2ba7ccd
--- /dev/null
+++ b/crates/codegen/xai-grok-pager/src/branding.rs
@@ -0,0 +1,36 @@
+//! Narrow Groktimizer presentation hooks.
+//!
+//! The model remains a regular catalog entry; this module only gives its
+//! human-facing label a consistent accent anywhere Grok Build renders it.
+
+use ratatui::style::Color;
+
+pub const GROKTIMIZED_MODEL_NAME: &str = "Groktimized 2";
+pub const GROKTIMIZED_PURPLE: Color = Color::Rgb(168, 85, 247);
+pub const GROKTIMIZED_PURPLE_BRIGHT: Color = Color::Rgb(196, 132, 252);
+
+/// Labels can carry transient UI suffixes such as `(current)` or `(high)`.
+pub fn is_groktimized_label(label: &str) -> bool {
+    let label = label.trim();
+    label.eq_ignore_ascii_case(GROKTIMIZED_MODEL_NAME)
+        || label
+            .get(..GROKTIMIZED_MODEL_NAME.len())
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(GROKTIMIZED_MODEL_NAME))
+            && label
+                .get(GROKTIMIZED_MODEL_NAME.len()..)
+                .is_some_and(|suffix| suffix.starts_with(" ("))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn identifies_plain_and_decorated_labels_only() {
+        assert!(is_groktimized_label("Groktimized 2"));
+        assert!(is_groktimized_label("Groktimized 2 (current)"));
+        assert!(is_groktimized_label("groktimized 2 (high)"));
+        assert!(!is_groktimized_label("Groktimized 20"));
+        assert!(!is_groktimized_label("Grok 4.5"));
+    }
+}
