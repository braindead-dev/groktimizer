@@ -302,0 +315,19 @@ mod tests {
+    #[test]
+    fn groktimized_model_is_first_without_reordering_stock_models() {
+        let mut state = ModelState::default();
+        for (id, name) in [
+            ("grok-4.5", "Grok 4.5"),
+            ("groktimized-2", "Groktimized 2"),
+            ("grok-4", "Grok 4"),
+        ] {
+            let (id, info) = plain_model(id, name);
+            state.available.insert(id, info);
+        }
+
+        let names: Vec<_> = build_model_items(&state)
+            .into_iter()
+            .map(|item| item.match_text)
+            .collect();
+        assert_eq!(names, ["Groktimized 2", "Grok 4.5", "Grok 4"]);
+    }
