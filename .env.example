# Provider credentials used only by the persistent control-plane host.
BL_API_KEY=
BL_WORKSPACE=
RUNPOD_API_KEY=
XAI_API_KEY=
XAI_API_KEY_2=
GITHUB_TOKEN=

# Optional credential used by the optimized model endpoint installer/probe.
GROKTIMIZER_MODEL_API_KEY=

# Persistent backend settings. Generate independent random values for both secrets.
GTZ_API_TOKEN=
GTZ_STREAM_SIGNING_KEY=
GTZ_CONFIG=/etc/groktimizer/groktimizer.toml
GTZ_DB=/var/lib/groktimizer/groktimizer.db
GTZ_PUBLIC_URL=

