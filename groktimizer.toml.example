[project]
name = "demo"
shared_repo = "git@github.com:YOURORG/demo-kernels.git"   # work-products repo
tooling_repo = "https://github.com/braindead-dev/groktimizer.git" # this repo, pip-installable
image = "blaxel/py-app:latest"   # Debian 13; live-verified for grok CLI + tmux + pip
region = "us-pdx-1"

[caps]
max_active_projects = 2   # concurrent projects with live agents
max_teams = 5
max_agents_per_team = 3

[budget]
spend_ceiling_usd = 25.0
max_concurrent_pods = 2
allowed_gpu_types = ["NVIDIA GeForce RTX 4090"]
max_pod_lifetime_hours = 2.0

[research]
target_gain_pct = 5.0             # min perf gain orchestrators accept as a win
max_accuracy_loss_pct = 5.0       # max model-quality regression tolerated
benchmark_cmd = "python3 bench/benchmark.py"  # run in shared repo; prints metrics JSON
accuracy_cmd = "python3 bench/accuracy.py"    # run in shared repo; prints accuracy
orchestrator_model = "grok-4.5"
implementer_model = "grok-4.5"
reconciler_model = "grok-4.5"
reasoning_effort = "high"
