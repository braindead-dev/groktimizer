[Unit]
Description=Load Groktimizer secrets from Azure Key Vault
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=GTZ_KEY_VAULT=__GTZ_KEY_VAULT__
ExecStart=/usr/local/libexec/groktimizer-fetch-secrets
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

