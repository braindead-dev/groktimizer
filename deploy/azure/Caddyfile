__GTZ_DOMAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}

	log {
		output file /var/log/caddy/groktimizer-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

